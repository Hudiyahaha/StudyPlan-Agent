{
  "arena_version": "0.1",
  "agent_name": "StudyPlan Agent",
  "domain": "Study-Plan Builder",
  "description": "A bounded agent that creates conflict-aware study plans from timetable, tasks, deadlines, and availability.",
  "endpoint": "/arena/run",
  "health_endpoint": "/health",
  "implementation": "studyplan",
  "capabilities": [
    "task validation",
    "conflict detection",
    "study scheduling",
    "clarification",
    "plan summarization"
  ],
  "fault_types": [
    "none",
    "tool_timeout",
    "malformed_tool_output",
    "invalid_agent_decision"
  ],
  "limits": {
    "max_steps": 6,
    "max_tool_retries": 2,
    "run_timeout_seconds": 40,
    "max_response_bytes": 50000
  }
}
